{
  "name": "@concordium/wdk-wallet-concordium",
  "version": "1.0.0-beta.1",
  "description": "WDK wallet module for the Concordium blockchain: account derivation, native CCD, PLT + CIS-2 tokens, sponsored transactions, dev/testnet onboarding, and seed-based account recovery.",
  "type": "module",
  "main": "index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    }
  },
  "files": ["index.js", "src", "types", "README.md", "LICENSE"],
  "scripts": {
    "example": "node examples/example.mjs",
    "example:send": "node examples/example-send.mjs",
    "example:verify": "node examples/example-verify.mjs",
    "onboard:request": "node examples/example-onboard.mjs request",
    "onboard:create": "node examples/example-onboard.mjs create",
    "example:token": "node examples/example-token.mjs",
    "example:sponsored": "node examples/example-sponsored.mjs",
    "test": "node --test test/unit/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "test:all": "node --test test/unit/*.test.mjs test/integration/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Concordium/tether-wdk-concordium.git"
  },
  "homepage": "https://github.com/Concordium/tether-wdk-concordium#readme",
  "bugs": {
    "url": "https://github.com/Concordium/tether-wdk-concordium/issues"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "keywords": ["wdk", "wallet", "concordium", "ccd", "multi-chain", "tether"],
  "author": "Concordium",
  "license": "Apache-2.0",
  "dependencies": {
    "@tetherto/wdk-wallet": "1.0.0-beta.23",
    "@concordium/web-sdk": "12.0.2",
    "@grpc/grpc-js": "1.14.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
